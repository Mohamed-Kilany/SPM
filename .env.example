# Copy to .env before starting the stack. Every value below is for local
# development only and must be replaced for any shared or public deployment.

# Release metadata. A tagged release sets SPM_VERSION to the version without
# the v prefix; local builds keep "dev".
SPM_VERSION=dev

# Internal Prometheus metrics. The port is not published to the host; scrape it
# from the compose network. Set METRICS_TOKEN to require a bearer token.
METRICS_ADDR=0.0.0.0:9090
METRICS_TOKEN=
# Read-only backup status file inside the API container. Compose mounts
# ./backups at /backups. Leave empty to disable the spm_backup_* collector.
BACKUP_STATUS_FILE=/backups/backup-status.json

# PostgreSQL
POSTGRES_DB=spm
POSTGRES_USER=spm
POSTGRES_PASSWORD=change-me-postgres

# Migration safety. The API applies embedded forward migrations at startup.
# Local development does not require a backup. Production must set
# MIGRATION_REQUIRE_BACKUP=true, mount a verified dump and provide its SHA-256
# inline or in <MIGRATION_BACKUP_PATH>.sha256. See docs/MIGRATIONS.md.
MIGRATION_LOCK_TIMEOUT=5s
MIGRATION_STATEMENT_TIMEOUT=2m
MIGRATION_REQUIRE_BACKUP=false
MIGRATION_BACKUP_PATH=
MIGRATION_BACKUP_SHA256=

# Backup bundles. These variables are read by scripts/backup.ps1 and
# scripts/restore-drill.ps1, not by the API. The key must be stored outside the
# backup destination and never committed. See docs/BACKUP-RESTORE.md.
SPM_BACKUP_KEY_FILE=
SPM_BACKUP_OUTPUT_DIR=./backups
SPM_BACKUP_OFFHOST_DIR=
SPM_BACKUP_REQUIRE_OFFHOST=false
SPM_BACKUP_KEEP_LAST=7
SPM_BACKUP_KEEP_DAYS=30
SPM_BACKUP_STATUS_FILE=./backups/backup-status.json
SPM_BACKUP_ALERT_WEBHOOK=

# Gitea database (created by 000_create_gitea_db.sql in the same PostgreSQL)
GITEA_DB=git

# Gitea server
GITEA_ROOT_URL=http://localhost:3000
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_SECRET_KEY=change-me-gitea-secret
GITEA_INTERNAL_TOKEN=change-me-gitea-internal-token
# start-stack.ps1 replaces this with a registration token generated by Gitea.
GITEA_RUNNER_TOKEN=change-me-runner-registration-token

# SPM API
JWT_SECRET=change-me-jwt-secret
# Short-lived access tokens plus rotating refresh tokens. Refresh tokens are
# stored only by the client; the API keeps SHA-256 hashes. See docs/SESSIONS.md.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=1440
# 0 disables the per-user concurrent-session cap.
SESSION_LIMIT_PER_USER=20
SESSION_RETENTION_DAYS=30
# Legacy fallback: used only when ACCESS_TOKEN_TTL_MINUTES is unset.
# JWT_EXPIRY_HOURS=8
# start-stack.ps1 replaces this with an access token generated for spm-admin.
GITEA_API_TOKEN=change-me-gitea-api-token
GITEA_ORG=spm
GITEA_WEBHOOK_SECRET=change-me-webhook-secret
# Public URL shown in the UI; internal URL is used by Gitea to call the API.
SPM_WEBHOOK_BASE_URL=http://localhost:8080
SPM_INTERNAL_WEBHOOK_URL=http://api_backend:8080/api/v1/webhooks/gitea
ARGOCD_WEBHOOK_TOKEN=change-me-argocd-token
# Read-only Argo CD API reconciliation (set a token for authenticated installs).
ARGOCD_ENABLED=true
ARGOCD_BASE_URL=http://k3s:30080
ARGOCD_TOKEN=

# k3s (lightest real Kubernetes for the local stack)
K3S_TOKEN=change-me-k3s-cluster-token
K3S_API_PORT=6443
ARGOCD_PORT=9090
MANIFEST_REPO_PATH=spm-manifests
MANIFEST_IMAGE_TAG_PATH=deploy/image-tag.txt
API_PORT=8080

# AI service (stateless, CPU-only, offline by default)
# Set AI_LLM=1 at build time only when mounting a local GGUF model.
AI_LLM=0
SPM_AI_DISABLE_LLM=1
SPM_AI_MODEL_PATH=
SPM_AI_THREADS=2

# UI
UI_PORT=80

# NATS retention
NATS_EVENT_RETENTION_DAYS=90

# Audit retention. Whole monthly partitions older than this are dropped by the
# audited job; 0 disables pruning. Defaults to 365 when unset.
AUDIT_RETENTION_DAYS=365

# Work item attachments. Files are validated, scanned and stored in the
# attachments_data volume; ClamAV is optional and uploads fail closed when a
# configured scanner is unreachable. ATTACHMENT_MAX_BYTES defaults to 10 MiB.
ATTACHMENT_MAX_BYTES=10485760
CLAMAV_ADDR=
