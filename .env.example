# Copy to .env before starting the stack. Every value below is for local
# development only and must be replaced for any shared or public deployment.

# Release metadata. A tagged release sets SPM_VERSION to the version without
# the v prefix; local builds keep "dev".
SPM_VERSION=dev

# Internal Prometheus metrics. The port is not published to the host; scrape it
# from the compose network. Set METRICS_TOKEN to require a bearer token.
METRICS_ADDR=0.0.0.0:9090
METRICS_TOKEN=

# PostgreSQL
POSTGRES_DB=spm
POSTGRES_USER=spm
POSTGRES_PASSWORD=change-me-postgres

# Gitea database (created by 000_create_gitea_db.sql in the same PostgreSQL)
GITEA_DB=git

# Gitea server
GITEA_ROOT_URL=http://localhost:3000
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_SECRET_KEY=change-me-gitea-secret
GITEA_INTERNAL_TOKEN=change-me-gitea-internal-token
# start-stack.ps1 replaces this with a registration token generated by Gitea.
GITEA_RUNNER_TOKEN=change-me-runner-registration-token

# SPM API
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRY_HOURS=8
# start-stack.ps1 replaces this with an access token generated for spm-admin.
GITEA_API_TOKEN=change-me-gitea-api-token
GITEA_ORG=spm
GITEA_WEBHOOK_SECRET=change-me-webhook-secret
# Public URL shown in the UI; internal URL is used by Gitea to call the API.
SPM_WEBHOOK_BASE_URL=http://localhost:8080
SPM_INTERNAL_WEBHOOK_URL=http://api_backend:8080/api/v1/webhooks/gitea
ARGOCD_WEBHOOK_TOKEN=change-me-argocd-token
# Read-only Argo CD API reconciliation (set a token for authenticated installs).
ARGOCD_ENABLED=true
ARGOCD_BASE_URL=http://k3s:30080
ARGOCD_TOKEN=

# k3s (lightest real Kubernetes for the local stack)
K3S_TOKEN=change-me-k3s-cluster-token
K3S_API_PORT=6443
ARGOCD_PORT=9090
MANIFEST_REPO_PATH=spm-manifests
MANIFEST_IMAGE_TAG_PATH=deploy/image-tag.txt
API_PORT=8080

# AI service (stateless, CPU-only, offline by default)
# Set AI_LLM=1 at build time only when mounting a local GGUF model.
AI_LLM=0
SPM_AI_DISABLE_LLM=1
SPM_AI_MODEL_PATH=
SPM_AI_THREADS=2

# UI
UI_PORT=80

# NATS retention
NATS_EVENT_RETENTION_DAYS=90
