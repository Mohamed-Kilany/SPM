# ─────────────────────────────────────────────────────────────────────────────
# SPM Platform — repository hygiene
#
# Rules for this file:
#   1. Never ignore source, tests, migrations, docs, Compose files or workflows.
#   2. Ignore every local secret, credential, kubeconfig, key, certificate,
#      database dump, backup, model, build output and machine-specific file.
#   3. Keep `.env.example` tracked; all other `.env*` files are local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local environment and secrets ────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.local
secrets/
.secrets/
credentials/
credentials.*
!credentials.example

# ── Kubernetes and cluster access ────────────────────────────────────────────
kube-config.yaml
kube-config.yml
kubeconfig
kubeconfig.*
*kubeconfig*
!k8s/**

# ── Keys, certificates and keystores ─────────────────────────────────────────
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.kdbx

# ── Backups, dumps and archives ──────────────────────────────────────────────
backups/
*.bak
*.backup
*.dump
*.sql.gz
*.sql.bz2
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# ── Mirrored container images and large binary assets ────────────────────────
images/
*.img
*.iso

# ── AI models and model caches ───────────────────────────────────────────────
ai/models/
ai/model_cache/
ai/.cache/
*.gguf
*.ggml
*.safetensors
*.onnx
*.bin
!**/testdata/**/*.bin

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
env/
.coverage
.coverage.*
htmlcov/

# ── Node / Vue ───────────────────────────────────────────────────────────────
node_modules/
ui/node_modules/
ui/dist/
ui/.vite/
ui/coverage/
ui/*.tsbuildinfo
ui/test-results/
ui/playwright-report/
ui/blob-report/
ui/.playwright/
playwright/.cache/

# ── Go ───────────────────────────────────────────────────────────────────────
api/spm-api
api/spm-api.exe
api/*.exe
api/*.test
api/coverage.out
api/coverage.html
api/tmp/
api/.cache/
api/.env

# ── Logs and temporary files ─────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ── Editors and operating systems ────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
