# Build context: repo root (.)
FROM golang:1.27-alpine AS builder
WORKDIR /build
COPY api/go.mod api/go.sum ./
RUN go mod download
COPY api/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /spm-api ./cmd/api

FROM alpine:3.21
RUN apk add --no-cache wget ca-certificates
COPY --from=builder /spm-api /spm-api
EXPOSE 8080
ENTRYPOINT ["/spm-api"]
