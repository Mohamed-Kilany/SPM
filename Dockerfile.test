# Multi-stage test runner image for the SPM platform CI gate.
#
# go_test            — builds the API and runs the Go unit suite.
# node_test          — runs the UI typecheck, Vitest suite and production build.
# integration_runner — combines both unit results and runs the tagged integration suite.
# integration_only   — compiles and runs only the tagged integration suite for CI.

# ── Go test stage ────────────────────────────────────────────────────────────
FROM golang:1.27.4-alpine AS go_test

WORKDIR /app

# Cache module downloads
COPY api/go.mod api/go.sum ./api/
RUN cd api && go mod download

# Copy full source
COPY api/ ./api/

# Run unit tests first (no stack needed).
# Integration tests require env vars and are run as a second pass when the
# full stack is up (controlled by the test_runner service below).
RUN cd api && go vet ./... \
    && go test ./... -count=1 -timeout 120s \
    && echo "GO_UNIT_TESTS=PASS" > /go_unit_result.txt \
    || (echo "GO_UNIT_TESTS=FAIL" > /go_unit_result.txt && cat /go_unit_result.txt && exit 1)

# Build the binary so we can confirm it compiles end-to-end.
RUN cd api && CGO_ENABLED=0 go build -o /spm-api ./cmd/api

# ── Node test stage ──────────────────────────────────────────────────────────
FROM node:24-alpine AS node_test

WORKDIR /app/ui

COPY ui/package.json ui/package-lock.json* ./
RUN npm ci --prefer-offline 2>/dev/null || npm install

COPY ui/ ./

RUN npm run typecheck \
    && npx vitest run --reporter=verbose 2>&1 \
    && npm run build \
    && echo "NODE_UNIT_TESTS=PASS" > /node_unit_result.txt \
    || (echo "NODE_UNIT_TESTS=FAIL" > /node_unit_result.txt && cat /node_unit_result.txt && exit 1)

# ── Full local integration runner ────────────────────────────────────────────
# Used by the manual full-stack command documented in docs/TESTING.md. The COPY
# instructions below force Docker to execute the Go unit-test and frontend
# typecheck/Vitest stages, so the image represents the complete local gate
# rather than integration tests alone. The PR gate uses `integration_only`.
FROM golang:1.27.4-alpine AS integration_runner

RUN apk add --no-cache curl

COPY --from=go_test /go_unit_result.txt /test-results/go_unit_result.txt
COPY --from=node_test /node_unit_result.txt /test-results/node_unit_result.txt
RUN cat /test-results/go_unit_result.txt /test-results/node_unit_result.txt

WORKDIR /app

COPY api/go.mod api/go.sum ./api/
RUN cd api && go mod download

COPY api/ ./api/

# Compile the integration test binary during the image build. Compiling with
# the integration tag is memory-hungry; doing it here keeps the constrained
# runtime container (256 MB) from being OOM-killed before the tests start.
RUN cd api && CGO_ENABLED=0 go test -tags integration -c \
        -o /integration.test ./tests/integration/...

# Default command: run the precompiled integration tests.
# Environment variables are injected by docker-compose.test.yml.
CMD /integration.test -test.v -test.count=1 -test.timeout=300s \
    && echo "INTEGRATION_TESTS=PASS" \
    || (echo "INTEGRATION_TESTS=FAIL" && exit 1)

# ── Integration-only runner ──────────────────────────────────────────────────
# The pull-request gate runs the Go unit suite, the UI suite and this
# integration suite in separate jobs, so this target deliberately does not
# re-run the unit stages. It compiles the tagged suite once and runs it against
# the live PostgreSQL/NATS/Gitea stack.
FROM golang:1.27.4-alpine AS integration_only

WORKDIR /app

COPY api/go.mod api/go.sum ./api/
RUN cd api && go mod download

COPY api/ ./api/

RUN cd api && CGO_ENABLED=0 go test -tags integration -c \
        -o /integration.test ./tests/integration/...

CMD ["sh", "-c", "/integration.test -test.v -test.count=1 -test.timeout=300s"]
